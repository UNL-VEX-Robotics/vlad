{% extends "../layout.twig" %}

{% block content %}
<style>
    .vlad-input {
        width: 100%; 
        background: var(--bg-body); 
        border: 1px solid var(--border-color);
        color: var(--text-main); 
        padding: 12px; 
        border-radius: 6px; 
        font-size: 0.95rem;
        box-sizing: border-box; 
    }
    
    .vlad-btn-accent {
        background: var(--accent-red); 
        color: white; 
        border: none; 
        padding: 12px 20px; 
        border-radius: 6px; 
        cursor: pointer; 
        font-weight: bold; 
        font-size: 0.9rem;
        width: 100%;
        transition: opacity 0.2s;
    }
    
    .vlad-btn-secondary {
        background: transparent; 
        color: var(--text-muted); 
        border: 1px solid var(--border-color); 
        padding: 10px 20px; 
        border-radius: 6px; 
        cursor: pointer; 
        font-size: 0.8rem; 
        font-weight: bold; 
        text-transform: uppercase; 
        transition: all 0.2s;
        text-decoration: none; 
        display: block; 
        text-align: center;
        width: 100%;
        box-sizing: border-box;
    }
    
    .vlad-btn-accent:hover { opacity: 0.9; }
    .vlad-btn-secondary:hover { border-color: var(--accent-red); color: var(--accent-red); }

    .card { 
        background: var(--bg-card); 
        border: 1px solid var(--border-color); 
        padding: 30px; /* Balanced padding */
        border-radius: 8px; 
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        width: 100%;
        box-sizing: border-box;
    }

    .button-stack {
        display: flex;
        flex-direction: column;
        gap: 10px; 
        margin-top: 20px;
    }
</style>

<div style="display: flex; justify-content: center; align-items: flex-start; min-height: 80vh; padding-top: 60px;">
    <div class="card" style="max-width: 520px;">
        <form method="POST" action="/settings/finalize-email">
            <h2 style="color: var(--text-heading); margin-bottom: 20px; font-size: 1.4rem; letter-spacing: -0.5px;">Finalize Email Change</h2>
            
            {% if error %}
                <div class="alert-box" style="background: rgba(255,0,0,0.1); color: var(--accent-red); padding: 10px 15px; border-radius: 4px; margin-bottom: 20px; font-size: 0.85rem; border: 1px solid rgba(255,0,0,0.2);">
                    {{ error }}
                </div>
            {% endif %}
            
            <input type="hidden" name="token" value="{{ token }}" />
            
            <div style="margin-bottom: 20px;">
                <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 4px;">Confirming new address:</p>
                <p style="color: var(--text-main); font-size: 1.05rem; margin: 0; font-weight: 500;">
                    {{ pending_email }}
                </p>
            </div>

            <div class="form-group" style="margin-bottom: 10px;">
                <label style="display:block; font-size: 0.65rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.05rem;">
                    Current Password
                </label>
                <input type="password" name="password" placeholder="••••••••" class="vlad-input" required />
            </div>

            <div class="button-stack">
                <button type="submit" class="vlad-btn-accent">Confirm Change</button>
                <a href="/settings" class="vlad-btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
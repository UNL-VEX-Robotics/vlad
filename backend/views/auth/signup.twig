{% extends "../layout.twig" %}

{% block content %}
<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh; 
        padding: 40px 20px;
    }

    .auth-card {
        width: 100%;
        max-width: 420px; 
    }

    .btn {
        display: block;
        width: 100%;
        padding: 12px;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        box-sizing: border-box;
        text-decoration: none;
        border: none;
    }

    .btn-primary {
        background-color: var(--accent-red);
        color: white;
    }

    .btn-primary:hover {
        background-color: var(--accent-hover);
    }

    .btn-secondary {
        background-color: var(--btn-secondary-bg);
        color: var(--btn-secondary-text);
        margin-top: 15px;
    }

    .btn-secondary:hover {
        filter: brightness(0.95);
    }

    .password-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
        margin-bottom: 1.2rem;
    }

    .password-wrapper input {
        width: 100%;
        padding-right: 65px; 
        box-sizing: border-box;
        margin: 0;
        background-color: var(--input-bg);
        color: var(--text-main);
        border: 1px solid var(--border-color);
    }

    .password-toggle-text {
        position: absolute;
        right: 15px;
        cursor: pointer;
        font-size: 0.75rem;
        color: var(--text-muted);
        user-select: none;
        font-weight: bold;
        z-index: 10;
        background: transparent;
    }

    .password-hints {
        padding-left: 18px; 
        padding-bottom: 12px; 
        margin: 0; 
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .alert-box {
        background-color: var(--alert-bg);
        color: var(--alert-text);
        border: 1px solid var(--alert-border);
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        text-align: center;
        font-weight: 500;
    }
</style>

<div class="auth-container">
    <div class="card auth-card">
        <form method="POST" action="/auth/signup">
            <h2 style="margin-top: 0;">Sign Up</h2>
            
            {% if error %}
                <div class="alert-box">{{ error }}</div>
            {% endif %}
            
            <label>Username</label>
            <input name="user_name" placeholder="Username" required />
            
            <label>Email</label>
            <input name="email" type="email" placeholder="Email" inputmode="email" required />
            
            <label>Password Requirements</label>
            <ul class="password-hints">
                <li>Minimum 8 characters</li>
                <li>Include at least one uppercase letter</li>
                <li>Include at least one number</li>
                <li>Include at least one special character (!@#$)</li>
            </ul>
            
            <label>Password</label>
            <div class="password-wrapper">
                <input type="password" id="pass" name="password" placeholder="Password" required />
                <span class="password-toggle-text" onclick="togglePassword('pass', this)">Show</span>
            </div>

            <label>Confirm Password</label>
            <div class="password-wrapper">
                <input type="password" id="confirmPass" name="confirmPassword" placeholder="Confirm Password" required />
                <span class="password-toggle-text" onclick="togglePassword('confirmPass', this)">Show</span>
            </div>
            
            <input type="submit" value="Create Account" class="btn btn-primary" style="margin-top: 15px;" />
        </form>

        <a href="/auth/login" class="btn btn-secondary">
            Already have an account? Login
        </a>
    </div>
</div>

<script>
    function togglePassword(inputId, element) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
            input.type = "text";
            element.textContent = "Hide";
        } else {
            input.type = "password";
            element.textContent = "Show";
        }
    }
</script>
{% endblock %}
{% extends "../layout.twig" %}

{% block content %}
<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh; 
        padding: 40px 20px;
    }

    .auth-card {
        width: 100%;
        max-width: 420px; 
    }

    .alert-box {
        background-color: var(--alert-bg);
        color: var(--alert-text);
        border: 1px solid var(--alert-border);
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        text-align: center;
        font-weight: 500;
    }

    .btn {
        display: block;
        width: 100%;
        padding: 12px;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        box-sizing: border-box;
        text-decoration: none;
        border: none;
    }

    .btn-primary {
        background-color: var(--accent-red);
        color: white;
    }

    .btn-primary:hover {
        background-color: var(--accent-hover);
    }

    .btn-secondary {
        background-color: var(--btn-secondary-bg);
        color: var(--btn-secondary-text);
        margin-top: 15px;
    }

    .btn-secondary:hover {
        filter: brightness(0.95);
    }

    /* INPUT STYLING */
    input:not([type="submit"]) {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        margin-bottom: 1rem;
        box-sizing: border-box;
        background-color: var(--input-bg);
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 4px;
    }

    .instruction-text {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-bottom: 20px;
        line-height: 1.4;
    }
</style>

<div class="auth-container">
    <div class="card auth-card">
        <form method="POST" action="/auth/create-team">
            <h2 style="margin-top: 0; color: var(--text-heading);">Create A New Team</h2>
            
            {% if error %}
                <div class="alert-box">{{ error }}</div>
            {% endif %}
            
            <p class="instruction-text">
                As the creator, you will be the team lead and manage join requests.
            </p>
            
            <label style="color: var(--text-label);">Team Name</label>
            <input name="team_name" placeholder="e.g. Alpha Squad" required />
            
            <input type="submit" value="Establish Team" class="btn btn-primary" />
        </form>

        <a href="/dashboard" class="btn btn-secondary">Cancel</a>
    </div>
</div>
{% endblock %}